# Database Configuration (Defaults to SQLite for local turnkey run)
DATABASE_URL=sqlite:///./agentguard.db
# For PostgreSQL:
# DATABASE_URL=postgresql://agentguard:agentguard_secret@localhost:5432/agentguard_db

# Redis Configuration (Optional; thread-safe atomic in-memory state store used if unset)
# REDIS_URL=redis://localhost:6379/0

# Risk Assessment Thresholds
RISK_LOW_THRESHOLD=40
RISK_HIGH_THRESHOLD=75

# Fail-Closed Enforcement
FAIL_CLOSED=true
